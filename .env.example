# VitalPeak — configuración local (copia este archivo a `.env`)
#
# --- Opción A: Ollama local (GRATIS) ---
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL=qwen2.5:14b
#
# Modelos alternativos:
#   OPENAI_MODEL=llama3.1:8b          # menos RAM (~8 GB)
#   OPENAI_MODEL=qwen2.5:7b           # más ligero
#   OPENAI_MODEL=mistral-nemo:12b
#
# Comandos Ollama:
#   ollama pull qwen2.5:14b
#   ollama serve
#
# --- Opción B: OpenAI Cloud (de pago) ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# (deja OPENAI_BASE_URL sin definir)
#
# --- Otros ---
# VITALPEAK_SEED=1
# APP_BASE_URL=http://localhost:8501
